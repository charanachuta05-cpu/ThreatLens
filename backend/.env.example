# ThreatLens environment configuration
APP_NAME=ThreatLens
APP_ENV=development
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/threatlens_db

# JWT security
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Threat intelligence providers
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false
OTX_API_KEY=
OTX_ENABLED=false
