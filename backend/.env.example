# ThreatLens environment configuration
APP_NAME=ThreatLens
APP_ENV=development
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/threatlens_db

# JWT security
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Threat intelligence providers
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false
OTX_API_KEY=
OTX_ENABLED=false

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Notifications
EMAIL_NOTIFICATIONS_ENABLED=false
ACCESS_REQUEST_ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=
EMAIL_FROM=ThreatLens Security <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173
EMAIL_TIMEOUT_SECONDS=5
